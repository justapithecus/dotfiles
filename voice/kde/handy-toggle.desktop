[Desktop Entry]
Type=Application
Name=Handy: Toggle Transcription
Comment=Start or stop Handy speech-to-text
Exec=handy --toggle-transcription
Icon=audio-input-microphone
Terminal=false
Categories=Utility;
X-KDE-GlobalAccel-CommandShortcut=true
Actions=InvokeAction

[Desktop Action InvokeAction]
Name=Toggle transcription
Exec=handy --toggle-transcription
X-KDE-Shortcuts=Meta+Shift+V
